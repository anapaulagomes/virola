# Data directories
# Override the default project-relative locations under ./data
DATA_DIR=
RAW_DATA_DIR=

# Hugging Face cache directory (default: ~/.cache/huggingface)
HF_HOME=

# Set to any non-empty value to enable model pre-download into HF_HOME/hub
# Useful for offline / SLURM / air-gapped environments
HF_FROM_LIMITED_ENV=

# LLM model identifier used by the project (default: llama3.2:1b)
LLM_MODEL=

# Skip patterns for indicative-code filtering
# Format: semicolon-separated entries of "code_type|regex"
# Use "*" as code_type to match all types
# Example: cid10|^Z;*|^ABP
# (default: cid10|^Z)
VIROLA_SKIP_PATTERNS=

# Number of CPU threads for embeddings inference fallback when os.cpu_count() is unavailable
NUMBER_OF_THREADS=

# Set automatically by SLURM; overrides numba thread count when present
SLURM_CPUS_PER_TASK=
